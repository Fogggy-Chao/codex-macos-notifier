#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  task-notify [title] [message]
  echo "Longer message" | task-notify [title]

Examples:
  task-notify "Codex" "Task finished"
  npm test && task-notify "Tests" "All tests passed"

Environment:
  TASK_NOTIFY_SOUND=Glass  Optional macOS sound name for the AppleScript fallback.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

title="${1:-Task Finished}"
message="${2:-}"
sound="${TASK_NOTIFY_SOUND:-}"

if [[ -z "$message" && ! -t 0 ]]; then
  message="$(cat)"
fi

if [[ -z "$message" ]]; then
  message="Your task has finished."
fi

send_with_osascript() {
  if [[ -n "$sound" ]]; then
    /usr/bin/osascript \
      -e 'on run argv' \
      -e 'set notificationTitle to item 1 of argv' \
      -e 'set notificationMessage to item 2 of argv' \
      -e 'set notificationSound to item 3 of argv' \
      -e 'display notification notificationMessage with title notificationTitle sound name notificationSound' \
      -e 'end run' \
      "$title" "$message" "$sound"
  else
    /usr/bin/osascript \
      -e 'on run argv' \
      -e 'set notificationTitle to item 1 of argv' \
      -e 'set notificationMessage to item 2 of argv' \
      -e 'display notification notificationMessage with title notificationTitle' \
      -e 'end run' \
      "$title" "$message"
  fi
}

if command -v terminal-notifier >/dev/null 2>&1 && terminal-notifier -title "$title" -message "$message" 2>/dev/null; then
  exit 0
elif [[ -x /opt/homebrew/bin/terminal-notifier ]] && /opt/homebrew/bin/terminal-notifier -title "$title" -message "$message" 2>/dev/null; then
  exit 0
fi

send_with_osascript
