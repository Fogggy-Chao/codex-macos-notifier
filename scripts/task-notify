#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  task-notify [title] [message]
  echo "Longer message" | task-notify [title]

Examples:
  task-notify "Codex" "Task finished"
  npm test && task-notify "Tests" "All tests passed"

Environment:
  TASK_NOTIFY_SOUND=Glass  Optional macOS sound name for the AppleScript fallback.
  TASK_NOTIFY_ACTIVATE_APP  Optional macOS bundle id to focus when the banner is clicked.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

title="${1:-Task Finished}"
message="${2:-}"
sound="${TASK_NOTIFY_SOUND:-}"
activate_app="${TASK_NOTIFY_ACTIVATE_APP:-}"

if [[ -z "$message" && ! -t 0 ]]; then
  message="$(cat)"
fi

if [[ -z "$message" ]]; then
  message="Your task has finished."
fi

if [[ -z "$activate_app" ]]; then
  case "${TERM_PROGRAM:-}" in
    Apple_Terminal)
      activate_app="com.apple.Terminal"
      ;;
    iTerm.app)
      activate_app="com.googlecode.iterm2"
      ;;
    WezTerm)
      activate_app="com.github.wez.wezterm"
      ;;
    WarpTerminal)
      activate_app="dev.warp.Warp-Stable"
      ;;
    vscode)
      activate_app="com.microsoft.VSCode"
      ;;
  esac
fi

send_with_osascript() {
  if [[ -n "$sound" ]]; then
    /usr/bin/osascript \
      -e 'on run argv' \
      -e 'set notificationTitle to item 1 of argv' \
      -e 'set notificationMessage to item 2 of argv' \
      -e 'set notificationSound to item 3 of argv' \
      -e 'display notification notificationMessage with title notificationTitle sound name notificationSound' \
      -e 'end run' \
      "$title" "$message" "$sound"
  else
    /usr/bin/osascript \
      -e 'on run argv' \
      -e 'set notificationTitle to item 1 of argv' \
      -e 'set notificationMessage to item 2 of argv' \
      -e 'display notification notificationMessage with title notificationTitle' \
      -e 'end run' \
      "$title" "$message"
  fi
}

terminal_notifier_args=(-title "$title" -message "$message")
if [[ -n "$activate_app" ]]; then
  terminal_notifier_args+=(-activate "$activate_app")
fi

if command -v terminal-notifier >/dev/null 2>&1 && terminal-notifier "${terminal_notifier_args[@]}" 2>/dev/null; then
  exit 0
elif [[ -x /opt/homebrew/bin/terminal-notifier ]] && /opt/homebrew/bin/terminal-notifier "${terminal_notifier_args[@]}" 2>/dev/null; then
  exit 0
fi

send_with_osascript
